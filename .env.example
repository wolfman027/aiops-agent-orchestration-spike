# ============================================================
# Holmes 诊断内核 spike — 启动配置模板
#
# 用法：cp .env.example .env  再按下面说明填入真实值。
#
# 由 aidiag/config.py（pydantic-settings）读取；环境变量兼容两套命名：
#   AIDIAG_*（本库前缀）与裸 DEEPSEEK_* / 裸通用名（DeepSeek 惯例），任选一套即可。
# 默认值的定义见 aidiag/config.py 字段 default。
# ============================================================

# ---------- LLM：真实诊断必需（第三方 DeepSeek API）----------
# 留空 → 服务仍能启动，但 build_model 自动回退 ScriptedJsonModel 桩：
#         REST diagnose 状态机能走通，结论却是桩文本，不是真诊断。
# 填真 key → OpenAIChatModel 走真实 DeepSeek（live golden / REST 才出真结论）。
DEEPSEEK_API_KEY=

# ---- 以下可选，一般不用改，确认默认值时取消注释 ----
# DeepSeek OpenAI 兼容端点
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 使用的模型名
# DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- 真实 MCP server（A3 控制面，trace_code 场景）----------
# git / app-log 两个角色各接一个真 MCP server（http，Streamable HTTP）。留空 url → 该角色
# 回退本地 stdio mock（scripts/mock_*_mcp.py，零配置可跑 trace_code）。服务启动时自动 seed +
# 加载；client 名 = 下面 NAME（工具在 tool_calls/结论里显示 mcp__<NAME>__<tool>）。
#
#   真 git server 只读工具： get_repo_status / get_commit_log / get_commit_detail /
#                            list_branches / search_code / blame_file
#   真 app-log server 工具： query_app_logs / query_chain_log_by_request_id
#
# AIDIAG_REPO_CWD = 本地 mock git server 服务的仓库目录（仅 mock 布局用）。
#   配什么：**只在没配 AIDIAG_GIT_MCP_URL（走本地 stdio mock）时**才用到——它作为 MOCK_GIT_REPO
#           喂给 scripts/mock_git_mcp.py；须指向一个真实的 git checkout。留空 → 默认取本 spike
#           仓库根目录。
#   接真 server 时本项**不使用**：仓库内容与 HEAD 都走 MCP（get_repo_status / search_code 等），
#   仓库定位由请求体的 repo 值决定。真 server 若要 HEAD，用 get_repo_status(仓库名) 即可。
#   ⚠️ 它**不是** git 地址——远端 git 地址是下面的 AIDIAG_GIT_MCP_URL。
AIDIAG_REPO_CWD=/Users/h.a.hu/accenture/accenture_aiops_platform/acc-aiops-platform/sip-aiops-management
#
# ⚠️ 行形状镜像生产 public.mcp_servers（http is_stateful=True、enable_tools=null）：真 server 的
#    只读边界在 server 端收敛，这里不做工具白名单。
AIDIAG_GIT_MCP_URL=http://127.0.0.1:8100/mcp
AIDIAG_GIT_MCP_NAME=git-search-mcp-server
# Bearer token；留空则不注入 Authorization header
AIDIAG_GIT_MCP_TOKEN=

AIDIAG_APPLOG_MCP_URL=http://127.0.0.1:8101/mcp
AIDIAG_APPLOG_MCP_NAME=app-log-search-mcp-server
AIDIAG_APPLOG_MCP_TOKEN=

# ---------- API 服务（启动绑定：make api / scripts/run_api.py 读取）----------
# uvicorn 绑定的主机与端口。demo 客户端（stage2_demo / api_demo）默认会跟随此端口，
# 不必每次传 --base。想换端口就在这里改，然后重启服务即可。
AIDIAG_API_HOST=127.0.0.1
AIDIAG_API_PORT=8017

# ---------- 诊断 agent 默认参数（可选）----------
# ReAct 循环最大迭代数
AIDIAG_MAX_ITERS=10
# session 过期时间（秒）
AIDIAG_SESSION_TTL_SECONDS=28800
# Stage2 驳回后最多重分析次数（达上限 → closed_manual）
AIDIAG_MAX_REANALYZE=3
